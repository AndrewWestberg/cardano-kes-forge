+//! The standard Sum6 construction, state/pair ordering, seed split and leaf
+//! primitives come from upstream common.rs, kes.rs and single_kes.rs. This
+//! specialization removes Compact/serde/secret-debug/allocating APIs and adds
+//! one-leaf scheduling and an immutable validated public tree. See SOURCE.json
+//! and adaptation.patch for the exact upstream identity and review history.
+use blake2::VarBlake2b;
+use blake2::digest::{Update, VariableOutput};
+use ed25519_dalek::{Signature, Signer, SigningKey, VerifyingKey};
+use zeroize::{Zeroize, Zeroizing};
+
+pub const PERIODS: u8 = 64;
+pub const STATE_BYTES: usize = 608;
+pub const SIGNATURE_BYTES: usize = 448;
+pub const PUBLIC_TREE_BYTES: usize = 4064;
+const DEPTH: usize = 6;
+const FIRST_LEAF: usize = 63;
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum Error {
+    InvalidPeriod,
+    ErasedKey,
+    Exhausted,
+    InvalidState,
+    InvalidSignature,
+    InvalidPublicTree,
+    TreeMismatch,
+    OutputInUse,
+    GenerationIncomplete,
+    GenerationComplete,
+}
+impl core::fmt::Display for Error {
+    fn fmt(&self, f: &mut core::fmt::Formatter<'_>) -> core::fmt::Result {
+        f.write_str(match self {
+            Self::InvalidPeriod => "relative period outside Sum6 lifetime",
+            Self::ErasedKey => "signing state is not live",
+            Self::Exhausted => "Sum6 lifetime exhausted",
+            Self::InvalidState => "invalid canonical signing state",
+            Self::InvalidSignature => "invalid Sum6 signature",
+            Self::InvalidPublicTree => "invalid public tree",
+            Self::TreeMismatch => "public tree does not match signing key",
+            Self::OutputInUse => "generation output already contains a live key",
+            Self::GenerationIncomplete => "cooperative generation incomplete",
+            Self::GenerationComplete => "cooperative generation already complete",
+        })
+    }
+}
+impl core::error::Error for Error {}
+
+fn fixed(bytes: &[u8]) -> &[u8; 32] {
+    bytes.try_into().expect("internal fixed-width slice")
+}
+fn pair(left: &[u8; 32], right: &[u8; 32]) -> [u8; 32] {
+    let mut out = [0; 32];
+    let mut hash = VarBlake2b::new(32).expect("fixed BLAKE2b-256 size");
+    hash.update(left);
+    hash.update(right);
+    hash.finalize_variable(|digest| out.copy_from_slice(digest));
+    out
+}
+// Upstream Seed::split_slice, with compiler-resistant owned seed erasure.
+// Primitive-internal stack/register erasure is not claimed by this wrapper.
+fn split(seed: &mut [u8; 32]) -> (Zeroizing<[u8; 32]>, Zeroizing<[u8; 32]>) {
+    let mut left = Zeroizing::new([0; 32]);
+    let mut right = Zeroizing::new([0; 32]);
+    let mut hash = VarBlake2b::new(32).expect("fixed BLAKE2b-256 size");
+    hash.update([1]);
+    hash.update(seed.as_slice());
+    hash.finalize_variable_reset(|digest| left.copy_from_slice(digest));
+    hash.update([2]);
+    hash.update(seed.as_slice());
+    hash.finalize_variable_reset(|digest| right.copy_from_slice(digest));
+    seed.zeroize();
+    (left, right)
+}
+fn node_for(period: u8, remaining_depth: usize) -> usize {
+    (1usize << (DEPTH - remaining_depth)) - 1 + (usize::from(period) >> remaining_depth)
+}
+fn state_offset(depth: usize) -> usize {
+    32 + 96 * (depth - 1)
+}
+
+/// Public storage only. Zero initialization is not a verified tree.
+pub struct PublicTreeBuffer([u8; PUBLIC_TREE_BYTES]);
+impl PublicTreeBuffer {
+    pub const fn new() -> Self {
+        Self([0; PUBLIC_TREE_BYTES])
+    }
+    pub fn as_bytes(&self) -> &[u8; PUBLIC_TREE_BYTES] {
+        &self.0
+    }
+    /// Load public immutable-object bytes directly, without an intermediate copy.
+    pub fn as_bytes_mut(&mut self) -> &mut [u8; PUBLIC_TREE_BYTES] {
+        &mut self.0
+    }
+    fn node(&self, index: usize) -> &[u8; 32] {
+        fixed(&self.0[index * 32..(index + 1) * 32])
+    }
+    fn set(&mut self, index: usize, value: &[u8; 32]) {
+        self.0[index * 32..(index + 1) * 32].copy_from_slice(value);
+    }
+    pub fn verify(&self, expected_root: &[u8; 32]) -> Result<VerifiedPublicTree<'_>, Error> {
+        if self.node(0) != expected_root {
+            return Err(Error::TreeMismatch);
+        }
+        for node in 0..FIRST_LEAF {
+            if self.node(node) != &pair(self.node(2 * node + 1), self.node(2 * node + 2)) {
+                return Err(Error::InvalidPublicTree);
+            }
+        }
+        Ok(VerifiedPublicTree { tree: self })
+    }
+}
+impl Default for PublicTreeBuffer {
+    fn default() -> Self {
+        Self::new()
+    }
+}
+
+/// Borrows an immutable, internally consistent tree bound to the expected VK.
+/// Snapshot/object authentication remains the persistence owner's obligation.
+pub struct VerifiedPublicTree<'a> {
+    tree: &'a PublicTreeBuffer,
+}
+impl VerifiedPublicTree<'_> {
+    pub fn root(&self) -> &[u8; 32] {
+        self.tree.node(0)
+    }
+    pub fn as_bytes(&self) -> &[u8; PUBLIC_TREE_BYTES] {
+        self.tree.as_bytes()
+    }
+}
+
+/// Owns and wipes exactly the canonical state. Relative-period metadata is
+/// separate and is never part of conventional key serialization. No Debug,
+/// Clone or serde implementation is provided for secret state.
+pub struct SigningState {
+    canonical: Zeroizing<[u8; STATE_BYTES]>,
+    period: Option<u8>,
+}
+impl SigningState {
+    pub fn erased() -> Self {
+        Self {
+            canonical: Zeroizing::new([0; STATE_BYTES]),
+            period: None,
+        }
+    }
+    pub fn is_live(&self) -> bool {
+        self.period.is_some()
+    }
+    pub fn period(&self) -> Option<u8> {
+        self.period
+    }
+    pub fn erase(&mut self) {
+        self.canonical.zeroize();
+        self.period = None;
+    }
+    pub fn from_canonical(bytes: &[u8; STATE_BYTES], period: u8) -> Result<Self, Error> {
+        if period >= PERIODS {
+            return Err(Error::InvalidPeriod);
+        }
+        let mut state = Self::erased();
+        state.canonical.copy_from_slice(bytes);
+        state.period = Some(period);
+        state.validate_current_path()?;
+        Ok(state)
+    }
+    pub fn canonical_bytes(&self) -> Result<&[u8; STATE_BYTES], Error> {
+        self.period.ok_or(Error::ErasedKey)?;
+        Ok(&self.canonical)
+    }
+    pub fn verification_key(&self) -> Result<[u8; 32], Error> {
+        self.period.ok_or(Error::ErasedKey)?;
+        Ok(pair(
+            fixed(&self.canonical[544..576]),
+            fixed(&self.canonical[576..608]),
+        ))
+    }
+    fn validate_current_path(&self) -> Result<(), Error> {
+        let period = self.period.ok_or(Error::ErasedKey)?;
+        let root = self.verification_key()?;
+        let mut expected = &root;
+        for level in (0..DEPTH).rev() {
+            let offset = 64 + 96 * level;
+            let left = fixed(&self.canonical[offset..offset + 32]);
+            let right = fixed(&self.canonical[offset + 32..offset + 64]);
+            if &pair(left, right) != expected {
+                return Err(Error::InvalidState);
+            }
+            expected = if period & (1 << level) == 0 {
+                left
+            } else {
+                right
+            };
+        }
+        let leaf = SigningKey::from_bytes(fixed(&self.canonical[..32]));
+        if leaf.verifying_key().as_bytes() != expected {
+            return Err(Error::InvalidState);
+        }
+        Ok(())
+    }
+    pub fn sign_into(
+        &self,
+        message: &[u8],
+        output: &mut [u8; SIGNATURE_BYTES],
+    ) -> Result<(), Error> {
+        self.period.ok_or(Error::ErasedKey)?;
+        let leaf = SigningKey::from_bytes(fixed(&self.canonical[..32]));
+        output[..64].copy_from_slice(&leaf.sign(message).to_bytes());
+        for level in 0..DEPTH {
+            let source = 64 + 96 * level;
+            let destination = 64 + 64 * level;
+            output[destination..destination + 64]
+                .copy_from_slice(&self.canonical[source..source + 64]);
+        }
+        Ok(())
+    }
+    /// Advance exactly one period using public subtree roots, never regenerate
+    /// a whole subtree. All checks precede mutation; final-period refusal leaves
+    /// the state unchanged. Enrolled network lifetime is an adapter obligation.
+    pub fn evolve(&mut self, cache: &VerifiedPublicTree<'_>) -> Result<(), Error> {
+        let current = self.period.ok_or(Error::ErasedKey)?;
+        if current == PERIODS - 1 {
+            return Err(Error::Exhausted);
+        }
+        if cache.root() != &self.verification_key()? {
+            return Err(Error::TreeMismatch);
+        }
+        let next = current + 1;
+        let transition_depth = next.trailing_zeros() as usize + 1;
+        let offset = state_offset(transition_depth);
+        let mut seed = Zeroizing::new([0; 32]);
+        seed.copy_from_slice(&self.canonical[offset..offset + 32]);
+        self.canonical[..offset + 32].zeroize();
+        for depth in (1..transition_depth).rev() {
+            let (left, right) = split(&mut seed);
+            let target = state_offset(depth);
+            let node = node_for(next, depth);
+            self.canonical[target..target + 32].copy_from_slice(&*right);
+            self.canonical[target + 32..target + 64].copy_from_slice(cache.tree.node(2 * node + 1));
+            self.canonical[target + 64..target + 96].copy_from_slice(cache.tree.node(2 * node + 2));
+            seed = left;
+        }
+        self.canonical[..32].copy_from_slice(&*seed);
+        self.period = Some(next);
+        Ok(())
+    }
+}
+
+pub fn verify(
+    root: &[u8; 32],
+    period: u8,
+    message: &[u8],
+    signature: &[u8; SIGNATURE_BYTES],
+) -> Result<(), Error> {
+    if period >= PERIODS {
+        return Err(Error::InvalidPeriod);
+    }
+    let mut expected = root;
+    for level in (0..DEPTH).rev() {
+        let offset = 64 + 64 * level;
+        let left = fixed(&signature[offset..offset + 32]);
+        let right = fixed(&signature[offset + 32..offset + 64]);
+        if &pair(left, right) != expected {
+            return Err(Error::InvalidSignature);
+        }
+        expected = if period & (1 << level) == 0 {
+            left
+        } else {
+            right
+        };
+    }
+    let key = VerifyingKey::from_bytes(expected).map_err(|_| Error::InvalidSignature)?;
+    let leaf = Signature::from_bytes(signature[..64].try_into().expect("fixed signature prefix"));
+    key.verify_strict(message, &leaf)
+        .map_err(|_| Error::InvalidSignature)
+}
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub struct GenerationProgress {
+    pub completed_leaves: u8,
+}
+
+/// Bounded, movable workspace for the device's one global generation job.
+/// Each step derives exactly one leaf VK. Owned secret state and the complete
+/// seed stack are zeroized on cancellation, failed completion, or drop.
+/// Completion moves the actual period-zero state and validated public tree;
+/// neither output needs a clone, allocation, or self-referential borrow.
+pub struct Generation {
+    output: SigningState,
+    tree: PublicTreeBuffer,
+    seeds: Zeroizing<[[u8; 32]; DEPTH + 1]>,
+    nodes: [u8; DEPTH + 1],
+    depths: [u8; DEPTH + 1],
+    stack: usize,
+    leaves: u8,
+}
+impl Generation {
+    pub fn begin(seed: &mut [u8; 32]) -> Result<Self, Error> {
+        let mut seeds = Zeroizing::new([[0; 32]; DEPTH + 1]);
+        seeds[0].copy_from_slice(seed);
+        seed.zeroize();
+        Ok(Self {
+            output: SigningState::erased(),
+            tree: PublicTreeBuffer::new(),
+            seeds,
+            nodes: [0; DEPTH + 1],
+            depths: [DEPTH as u8; DEPTH + 1],
+            stack: 1,
+            leaves: 0,
+        })
+    }
+    pub const fn completed_leaves(&self) -> u8 {
+        self.leaves
+    }
+    pub fn step(&mut self) -> Result<GenerationProgress, Error> {
+        if self.leaves == PERIODS {
+            return Err(Error::GenerationComplete);
+        }
+        loop {
+            self.stack -= 1;
+            let index = self.stack;
+            let depth = usize::from(self.depths[index]);
+            let node = usize::from(self.nodes[index]);
+            let mut seed = Zeroizing::new(core::mem::take(&mut self.seeds[index]));
+            if depth != 0 {
+                let (left, right) = split(&mut seed);
+                if self.leaves == 0 {
+                    let offset = state_offset(depth);
+                    self.output.canonical[offset..offset + 32].copy_from_slice(&*right);
+                }
+                self.push(2 * node + 2, depth - 1, &right);
+                self.push(2 * node + 1, depth - 1, &left);
+                continue;
+            }
+            if self.leaves == 0 {
+                self.output.canonical[..32].copy_from_slice(&*seed);
+            }
+            let key = SigningKey::from_bytes(&seed);
+            let tree = &mut self.tree;
+            tree.set(node, key.verifying_key().as_bytes());
+            let mut completed = node;
+            while completed != 0 && completed % 2 == 0 {
+                let parent = (completed - 2) / 2;
+                let public = pair(tree.node(2 * parent + 1), tree.node(2 * parent + 2));
+                tree.set(parent, &public);
+                completed = parent;
+            }
+            self.leaves += 1;
+            return Ok(GenerationProgress {
+                completed_leaves: self.leaves,
+            });
+        }
+    }
+    fn push(&mut self, node: usize, depth: usize, seed: &[u8; 32]) {
+        self.seeds[self.stack].copy_from_slice(seed);
+        self.nodes[self.stack] = node as u8;
+        self.depths[self.stack] = depth as u8;
+        self.stack += 1;
+    }
+    pub fn finish(mut self) -> Result<(SigningState, PublicTreeBuffer), Error> {
+        if self.leaves != PERIODS {
+            return Err(Error::GenerationIncomplete);
+        }
+        for depth in 1..=DEPTH {
+            let offset = state_offset(depth);
+            let node = node_for(0, depth);
+            self.output.canonical[offset + 32..offset + 64]
+                .copy_from_slice(self.tree.node(2 * node + 1));
+            self.output.canonical[offset + 64..offset + 96]
+                .copy_from_slice(self.tree.node(2 * node + 2));
+        }
+        self.output.period = Some(0);
+        self.tree.verify(&self.output.verification_key()?)?;
+        Ok((self.output, self.tree))
+    }
+}
