index-state:
  , hackage.haskell.org 2026-08-14T13:38:07Z
  , cardano-haskell-packages 2026-09-23T18:57:23Z

constraints:
  , any.crypton-x509-system < 1.6.8 || >= 1.7
  , any.proto-lens >= 0.7.1.7
  , any.alfred-margaret < 2.1.1.0 || > 2.1.1.0

packages:
  /home/westbam/haskell/ouroboros-consensus
  /home/westbam/haskell/cardano-node/cardano-node
  /home/westbam/haskell/cardano-node/trace-forward

extra-packages: dmq-node >= 0.7.0.0

program-options
  ghc-options: -Werror

test-show-details: direct
write-ghc-environment-files: never

package acts
  flags: -finitary

package cryptonite
  flags: -support_rdrand

package snap-server
  flags: -openssl

package bitvec
  flags: -simd

package cardano-diffusion
  flags: +optparse-applicative-fork

allow-newer:
  , io-sim:time
  , io-classes:time
